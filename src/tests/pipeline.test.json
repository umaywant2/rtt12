{
  "tests": [
    {
      "id": "rtt12.pipeline.001",
      "description": "Full pipeline succeeds with valid RTT/1 → RTT/2 → RTT/3 → RTT/12 inputs",
      "input": {
        "rtt1": {
          "claritySurface": {},
          "loadBearing": {},
          "contradictionScan": {},
          "structuralCritique": {}
        },
        "rtt2": {
          "gpuStack": {
            "regimeView": {},
            "driftView": {},
            "coherenceView": {}
          }
        },
        "rtt3": {
          "structuralTopology": [],
          "intersections": [],
          "surfaces": [],
          "gpuTopology": {
            "topology": {
              "surfaces": [],
              "intersections": [],
              "overlays": []
            }
          }
        }
      },
      "expected": {
        "engine": "RTT/12",
        "version": "2026.1",
        "unifiedTopology": {
          "clusters": [],
          "regimeSurfaces": [],
          "coherenceDrift": [],
          "gpuAligned": [],
          "metadata": {
            "pipeline": "rtt1→rtt2→rtt3→rtt12"
          }
        }
      }
    },

